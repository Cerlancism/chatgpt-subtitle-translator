# -- Required ------------------------------------------------ 

# OpenAI API key - https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-...

# -- Rate Limits ------------------------------------------------
# See https://platform.openai.com/docs/guides/rate-limits

# Maximum requests per minute for the translation API (default: 60)
# OPENAI_API_RPM=500

# Maximum requests per minute for the moderation endpoint (default: falls back to OPENAI_API_RPM)
# OPENAI_API_MODERATOR_RPM=60

# Default model to use for translation
# OPENAI_DEFAULT_MODEL=gpt-4o-mini

# -- Custom API Provider ------------------------------------------------
# Override the base URL to use any OpenAI-compatible provider

# OpenAI (default, no need to set)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama running locally
# OPENAI_BASE_URL=http://localhost:11434/v1

# Session id sent as the `x-session-id` header on every request. Providers that support it
# use it for sticky routing (keeps the prompt cache warm) and request grouping; others ignore it.
# Unset: a random id per run. Set a value to use a fixed id. Set to `off` to disable.
# OPENAI_SESSION_ID=off

# -- Output ------------------------------------------------

# Force the line ending used for generated files (.srt, plain text, progress .csv)
# Accepts: crlf, lf, auto
# Unset or `auto` keeps the existing per-writer behaviour: CRLF for .srt, LF for everything else
# SUBTITLE_LINE_ENDING=auto

# Proxy ------------------------------------------------

# HTTP_PROXY=http://user:pass@proxy.example.com:8080
# HTTPS_PROXY=http://user:pass@proxy.example.com:8080
